    <dl class="case-facts">
      <div><dt>Projet</dt><dd>Personnel, en ligne</dd></div>
      <div><dt>Rôle</dt><dd>Conception et développement, seul</dd></div>
      <div><dt>Pour qui</dt><dd>Tout le monde, sur téléphone ou ordinateur, sans compte ni installation</dd></div>
