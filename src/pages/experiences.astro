---
import MaquettePage from '../layouts/MaquettePage.astro';
import ProjectCard from '../components/maquette/ProjectCard.astro';
import { projects } from '../data/maquette';

const experiences = projects.filter((p) => p.experience);
---

<MaquettePage current="experiences">
  <section class="wrap">
    <p class="lead">
      Mes stages, racontés sans leur code quand il est propriétaire : le problème, ce que j'ai
      construit et la stack utilisée.
    </p>
    <div class="projects" style="margin-top: clamp(40px, 6vw, 72px)">
      {experiences.map((p, i) => <ProjectCard project={p} flip={i % 2 === 1} />)}
    </div>
  </section>
</MaquettePage>
