---
/* CV (mode recruteur, atteint par BOOT) : une page A4, générée à partir des mêmes données que le
 * site, en français ou en anglais (/en/cv). « Télécharger en PDF » passe par l'impression du
 * navigateur. */
import '../styles/maquette.css';
import SeoHead from '../components/SeoHead.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { content } from '../data/content';
import { langOf, tr } from '../i18n';

const lang = langOf(Astro.url);
const t = tr(lang);
const { PROFILE, cvExtras, links, projects, skills, steps, HOME } = content(lang);
// Le portfolio dans la langue du CV
const site = lang === 'en' ? `${links.site}/en` : links.site;

const experience = steps.filter((s) => !s.formation && s.cv !== false);
const education = steps.filter((s) => s.formation);
// Les stages présentés dans Expériences figurent déjà dans les expériences du CV
const cvProjects = projects.filter((p) => !p.experience && p.cv !== false);
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead
      title="CV - Matthias Germain"
      description={t(
        'CV de Matthias Germain, ingénieur logiciel embarqué et IoT à Strasbourg : expériences, projets et compétences.',
        'CV of Matthias Germain, embedded and IoT software engineer in Strasbourg: experience, projects and skills.',
      )}
    />
  </head>
  <body class="cv-page">
    <div class="cv-bar">
      <a class="pill pill-outline pill-sm" href={HOME}>← {t('Retour au site', 'Back to the site')}</a>
      <div class="cv-bar-end">
        <LangSwitch />
        <button class="pill pill-solid pill-sm" type="button" id="cv-print">{t('Télécharger en PDF', 'Download as PDF')}</button>
      </div>
    </div>

    <main class="cv-sheet">
      <header class="cv-head">
        <img class="cv-photo" src="/images/matthias-portrait.webp" alt={t('Photo de Matthias Germain', 'Photo of Matthias Germain')} width="352" height="440" />
        <div>
          <h1 class="cv-name display"><span class="light">Matthias</span> <span class="strong">GERMAIN</span></h1>
          {
            lang === 'en' ? (
              <p class="cv-role"><span class="hl">Embedded &amp; IoT</span> software engineer</p>
            ) : (
              <p class="cv-role">Ingénieur logiciel <span class="hl">embarqué &amp; IoT</span></p>
            )
          }
          <p class="cv-chain">{t("Du firmware à l'interface web", 'From firmware to web interface')}</p>
        </div>
        <dl class="cv-contact">
          <div><dt>{t('Tél.', 'Phone')}</dt><dd><a href={`tel:${links.phone.tel}`}>{links.phone.display}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${links.email}`}>{links.email}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={links.linkedin}>{short(links.linkedin)}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={links.github}>{short(links.github)}</a></dd></div>
          <div><dt>{t('Site', 'Website')}</dt><dd><a href={site}>{short(site)}</a></dd></div>
          <div><dt>{t('Basé à', 'Based in')}</dt><dd>Strasbourg{t('', ', France')}</dd></div>
        </dl>
      </header>

      <div class="cv-cols">
        <div class="cv-main">
          <section>
            <h2>{t('Profil', 'Profile')}</h2>
            <p>{PROFILE}</p>
          </section>

          <section>
            <h2>{t('Expériences', 'Experience')}</h2>
            <ol class="cv-list">
              {
                experience.map((s) => (
                  <li>
                    <div class="cv-row">
                      <h3>
                        {s.title} <span class="cv-where">· {s.where}</span>
                      </h3>
                      <p class="cv-when">{s.cvWhen ?? s.when}</p>
                    </div>
                    <p>{s.line}</p>
                  </li>
                ))
              }
            </ol>
          </section>

          <section>
            <h2>{t('Projets', 'Projects')}</h2>
            <ul class="cv-list">
              {
                cvProjects.map((p) => (
                  <li>
                    <h3>
                      {p.title}
                      {p.status && <span class="cv-status">{p.status}</span>}
                    </h3>
                    <p>
                      {p.cv || p.pitch} <span class="cv-stack">({p.stack.join(', ')})</span>
                    </p>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <aside class="cv-side">
          <section>
            <h2>{t('Compétences', 'Skills')}</h2>
            {
              skills.map((g) => (
                <div class="cv-skill">
                  <h3>{g.area}</h3>
                  <p>{g.items.join(', ')}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>{t('Formation', 'Education')}</h2>
            {
              education.map((s) => (
                <div class="cv-skill">
                  <div class="cv-row">
                    <h3>{s.title}</h3>
                    <p class="cv-when">{s.when}</p>
                  </div>
                  <p>{s.where}</p>
                  <p>{s.line}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>{t('Langues', 'Languages')}</h2>
            <p><b>{t('Français :', 'French:')}</b> {t('langue maternelle.', 'native.')}</p>
            <p class="cv-lang">
              <b>{t('Anglais :', 'English:')}</b>
              {t('B2 (TOEIC), langue de travail de mon stage chez Schaeffler.', 'B2 (TOEIC), working language during my internship at Schaeffler.')}
            </p>
          </section>

          <section>
            <h2>{t('Disponibilité', 'Availability')}</h2>
            <p class="cv-avail">
              <span class="chip-led" aria-hidden="true"></span>
              {
                t(
                  'Immédiatement, en CDI : poste embarqué ou web, à Strasbourg ou à Nancy.',
                  'Immediately, permanent position: embedded or web role, in Strasbourg or Nancy.',
                )
              }
            </p>
          </section>

          <section>
            <h2>{t('Autres', 'Other')}</h2>
            <ul class="cv-extras">{cvExtras.map((e) => <li>{e}</li>)}</ul>
          </section>
        </aside>
      </div>
    </main>

    <script>
      document.getElementById('cv-print')?.addEventListener('click', () => window.print());
    </script>

    <style>
      .cv-page { background: var(--cream); }
      .cv-bar {
        display: flex; justify-content: space-between; gap: 12px;
        width: min(210mm, 100%); margin: 0 auto; padding: 20px 16px 16px;
      }
      .cv-bar button { cursor: pointer; }
      .cv-bar-end { display: flex; align-items: center; gap: 16px; }

      /* Feuille A4 : 210 × 297 mm à l'écran comme à l'impression */
      .cv-sheet {
        position: relative;
        width: min(210mm, 100%); min-height: 297mm; margin: 0 auto 48px; padding: 10mm 17mm 10mm 13mm;
        background: var(--paper); box-shadow: 0 10px 40px rgba(30, 41, 82, 0.12);
        font-size: 8.9pt; line-height: 1.4; color: var(--ink);
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      /* Rappel de la charte du site : une bande jaune et une bande violette sur le bord droit */
      .cv-sheet::before, .cv-sheet::after { content: ''; position: absolute; top: 0; bottom: 0; }
      .cv-sheet::before { right: 2.5mm; width: 4.5mm; background: var(--sun); }
      .cv-sheet::after { right: 0; width: 2.5mm; background: var(--violet); }
      .cv-head { display: flex; align-items: center; gap: 5mm; padding-bottom: 3.5mm; border-bottom: 2px solid var(--ink); }
      .cv-photo {
        flex: none; width: 23mm; height: 28.5mm; object-fit: cover;
        border: 2px solid var(--ink); border-radius: 3mm; background: var(--paper);
      }
      .cv-name { font-size: 24pt; }
      .cv-role { margin-top: 1.5mm; font-family: var(--font-display); font-weight: 800; font-size: 12.5pt; }
      .cv-chain { margin-top: 1mm; color: var(--ink-70); font-weight: 500; }
      .cv-head > div { flex: 1; min-width: 0; }
      /* Contact dans l'en-tête : libellé et valeur sur la même ligne */
      .cv-contact { display: grid; grid-template-columns: auto auto; gap: 1mm 2.5mm; align-items: baseline; }
      .cv-contact div { display: contents; }
      .cv-contact dt { font-size: 6.6pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-70); }
      .cv-contact dd { font-size: 8pt; font-weight: 600; }
      .cv-contact a { color: inherit; text-decoration: none; border-bottom: 1.5px solid var(--sun); white-space: nowrap; }

      .cv-cols { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 6mm; margin-top: 4mm; }
      .cv-main, .cv-side { display: grid; align-content: start; gap: 3.6mm; }
      /* Titres soulignés au surligneur jaune, comme l'accroche du site */
      .cv-sheet h2 {
        width: fit-content; margin-bottom: 2mm; padding: 0 1mm;
        font-family: var(--font-display); font-weight: 900; font-size: 11pt; letter-spacing: 0.06em; text-transform: uppercase;
        /* Aplat sans transition (comme .hl) : un dégradé à arrêts nets bave à l'impression */
        background: linear-gradient(var(--sun), var(--sun)) 0 87.3% / 100% 37% no-repeat;
      }
      /* Pastille de broche devant chaque titre, comme sur le site */
      .cv-sheet h3 { font-weight: 700; font-size: 9.8pt; }
      .cv-list { display: grid; gap: 1.8mm; padding: 0; list-style: none; }
      .cv-row { display: flex; justify-content: space-between; align-items: baseline; gap: 3mm; }
      .cv-when { flex: none; font-size: 7.6pt; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-70); }
      .cv-where { font-weight: 500; color: var(--ink-70); }
      .cv-status {
        margin-left: 2mm; padding: 0 1.6mm; border: 1.2px solid var(--ink); border-radius: 99px;
        font-size: 7pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; vertical-align: 1px;
      }
      .cv-stack { font-size: 7.8pt; font-weight: 600; color: var(--ink-70); }
      .cv-side { padding-left: 5mm; border-left: 1px solid var(--line); }
      .cv-skill + .cv-skill { margin-top: 2.2mm; }
      .cv-lang { margin-top: 1.2mm; }
      .cv-avail { display: flex; align-items: center; gap: 2mm; }
      .cv-extras { display: grid; gap: 1.2mm; padding: 0; list-style: none; }
      .cv-avail .chip-led { flex: none; animation: none; }

      /* Écran étroit : la feuille devient une page fluide (jamais à l'impression, qui garde l'A4) */
      @media screen and (max-width: 760px) {
        .cv-sheet { min-height: 0; padding: 22px calc(18px + 7mm) 22px 18px; box-shadow: none; }
        .cv-head { flex-direction: column; align-items: flex-start; }
        .cv-head > div { flex: none; }
        .cv-cols { grid-template-columns: 1fr; }
        .cv-side { padding-left: 0; border-left: 0; }
      }

      @page { size: A4; margin: 0; }
      @media print {
        .cv-page { background: #fff; }
        .cv-bar { display: none; }
        .cv-sheet { width: 210mm; height: 297mm; margin: 0; box-shadow: none; overflow: hidden; }
      }
    </style>
  </body>
</html>
