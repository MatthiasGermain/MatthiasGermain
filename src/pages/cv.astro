---
/* CV (mode recruteur, atteint par BOOT) : une page A4, générée à partir des mêmes données que le
 * site. « Télécharger en PDF » passe par l'impression du navigateur.
 * Téléphone : seulement dans le CV envoyé. Il vient de CV_PHONE dans le `.env` local, qui n'est
 * jamais renseigné sur Vercel : la version en ligne n'affiche pas le numéro. */
import '../styles/maquette.css';
import SeoHead from '../components/SeoHead.astro';
import { PROFILE, links, projects, skills, steps } from '../data/maquette';

const phone = import.meta.env.CV_PHONE as string | undefined;
const experience = steps.filter((s) => !s.formation && s.cv !== false);
const education = steps.filter((s) => s.formation);
// Les stages présentés dans Expériences figurent déjà dans les expériences du CV
const cvProjects = projects.filter((p) => !p.experience);
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="fr">
  <head>
    <SeoHead
      title="CV - Matthias Germain"
      description="CV de Matthias Germain, ingénieur logiciel embarqué et IoT à Strasbourg : expériences, projets et compétences."
    />
  </head>
  <body class="cv-page">
    <div class="cv-bar">
      <a class="pill pill-outline pill-sm" href="/">← Retour au site</a>
      <button class="pill pill-solid pill-sm" type="button" id="cv-print">Télécharger en PDF</button>
    </div>

    <main class="cv-sheet">
      <header class="cv-head">
        <img class="cv-photo" src="/images/matthias-portrait.webp" alt="Photo de Matthias Germain" width="352" height="440" />
        <div>
          <h1 class="cv-name display"><span class="light">Matthias</span> <span class="strong">GERMAIN</span></h1>
          <p class="cv-role">Ingénieur logiciel <span class="hl">embarqué &amp; IoT</span></p>
          <p class="cv-chain">Du firmware à l'interface web</p>
          <ul class="cv-contact">
            <li>Strasbourg</li>
            <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
            {phone && <li><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></li>}
            <li><a href={links.linkedin}>{short(links.linkedin)}</a></li>
            <li><a href={links.github}>{short(links.github)}</a></li>
            <li><a href={links.site}>{short(links.site)}</a></li>
          </ul>
        </div>
      </header>

      <div class="cv-cols">
        <div class="cv-main">
          <section>
            <h2>Profil</h2>
            <p>{PROFILE}</p>
          </section>

          <section>
            <h2>Expériences</h2>
            <ol class="cv-list">
              {
                experience.map((s) => (
                  <li>
                    <div class="cv-row">
                      <h3>
                        {s.title} <span class="cv-where">· {s.where}</span>
                      </h3>
                      <p class="cv-when">{s.when}</p>
                    </div>
                    <p>{s.line}</p>
                  </li>
                ))
              }
            </ol>
          </section>

          <section>
            <h2>Projets</h2>
            <ul class="cv-list">
              {
                cvProjects.map((p) => (
                  <li>
                    <h3>
                      {p.title}
                      {p.status && <span class="cv-status">{p.status}</span>}
                    </h3>
                    <p>
                      {p.cv ?? p.pitch} <span class="cv-stack">({p.stack.join(', ')})</span>
                    </p>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <aside class="cv-side">
          <section>
            <h2>Compétences</h2>
            {
              skills.map((g) => (
                <div class="cv-skill">
                  <h3>{g.area}</h3>
                  <p>{g.items.join(', ')}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>Formation</h2>
            {
              education.map((s) => (
                <div class="cv-skill">
                  <div class="cv-row">
                    <h3>{s.title}</h3>
                    <p class="cv-when">{s.when}</p>
                  </div>
                  <p>{s.where}</p>
                  <p>{s.line}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>Langues</h2>
            <div class="cv-skill">
              <h3>Anglais</h3>
              <p>B2 (TOEIC), langue de travail de mon stage chez Schaeffler.</p>
            </div>
          </section>

          <section>
            <h2>Disponibilité</h2>
            <p class="cv-avail"><span class="chip-led" aria-hidden="true"></span> Poste embarqué ou web, à Strasbourg ou à Nancy.</p>
          </section>
        </aside>
      </div>
    </main>

    <script>
      document.getElementById('cv-print')?.addEventListener('click', () => window.print());
    </script>

    <style>
      .cv-page { background: var(--cream); }
      .cv-bar {
        display: flex; justify-content: space-between; gap: 12px;
        width: min(210mm, 100%); margin: 0 auto; padding: 20px 16px 16px;
      }
      .cv-bar button { cursor: pointer; }

      /* Feuille A4 : 210 × 297 mm à l'écran comme à l'impression */
      .cv-sheet {
        width: min(210mm, 100%); min-height: 297mm; margin: 0 auto 48px; padding: 11mm 13mm;
        background: #fff; box-shadow: 0 10px 40px rgba(30, 41, 82, 0.12);
        font-size: 8.9pt; line-height: 1.4; color: var(--ink);
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      .cv-head { display: flex; align-items: center; gap: 6mm; padding-bottom: 4.5mm; border-bottom: 2px solid var(--ink); }
      .cv-photo {
        flex: none; width: 25mm; height: 31mm; object-fit: cover;
        border: 2px solid var(--ink); border-radius: 3mm; background: var(--paper);
      }
      .cv-name { font-size: 24pt; }
      .cv-role { margin-top: 1.5mm; font-family: var(--font-display); font-weight: 800; font-size: 12.5pt; }
      .cv-chain { margin-top: 1mm; color: var(--ink-70); font-weight: 500; }
      .cv-contact { display: flex; flex-wrap: wrap; gap: 0.8mm 4mm; margin-top: 2.5mm; padding: 0; list-style: none; font-size: 8.6pt; font-weight: 600; }
      .cv-contact a { color: inherit; text-decoration: none; border-bottom: 1.5px solid var(--sun); }

      .cv-cols { display: grid; grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr); gap: 6mm; margin-top: 5mm; }
      .cv-main, .cv-side { display: grid; align-content: start; gap: 4.2mm; }
      .cv-sheet h2 {
        display: flex; align-items: center; gap: 2.5mm; margin-bottom: 2mm;
        font-family: var(--font-display); font-weight: 900; font-size: 11pt; letter-spacing: 0.06em; text-transform: uppercase;
      }
      /* Pastille de broche devant chaque titre, comme sur le site */
      .cv-sheet h2::before { content: ''; width: 2.6mm; height: 2.6mm; border: 1.5px solid var(--ink); border-radius: 0.6mm; background: var(--sun); }
      .cv-sheet h3 { font-weight: 700; font-size: 9.8pt; }
      .cv-list { display: grid; gap: 2mm; padding: 0; list-style: none; }
      .cv-row { display: flex; justify-content: space-between; align-items: baseline; gap: 3mm; }
      .cv-when { flex: none; font-size: 7.6pt; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-70); }
      .cv-where { font-weight: 500; color: var(--ink-70); }
      .cv-status {
        margin-left: 2mm; padding: 0 1.6mm; border: 1.2px solid var(--ink); border-radius: 99px;
        font-size: 7pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; vertical-align: 1px;
      }
      .cv-stack { font-size: 7.8pt; font-weight: 600; color: var(--ink-70); }
      .cv-side { padding-left: 5mm; border-left: 1px solid var(--line); }
      .cv-skill + .cv-skill { margin-top: 2.2mm; }
      .cv-avail { display: flex; align-items: center; gap: 2mm; }
      .cv-avail .chip-led { flex: none; animation: none; }
      .todo { margin-top: 2mm; padding: 1.5mm 2.5mm; border: 1.5px dashed var(--ink); border-radius: 1.5mm; background: rgba(252, 202, 70, 0.45); font-weight: 600; font-size: 8.4pt; }

      /* Écran étroit : la feuille devient une page fluide */
      @media (max-width: 760px) {
        .cv-sheet { min-height: 0; padding: 22px 18px; box-shadow: none; }
        .cv-head { flex-direction: column; align-items: flex-start; }
        .cv-cols { grid-template-columns: 1fr; }
        .cv-side { padding-left: 0; border-left: 0; }
      }

      @page { size: A4; margin: 0; }
      @media print {
        .cv-page { background: #fff; }
        .cv-bar { display: none; }
        .cv-sheet { width: 210mm; height: 297mm; margin: 0; box-shadow: none; overflow: hidden; }
      }
    </style>
  </body>
</html>
