>
  <div class="wrap">
    <p class="contact-links" style="margin-top: 0">
      <a class="pill pill-solid" href="/">← Retour à la carte</a>
      <a class="pill pill-outline" href="/projets">Voir les projets</a>
    </p>
    <p class="lead small" lang="en" style="margin-top: 32px">
      Page not found: this signal leads nowhere. <a href="/en">Back to the board, in English</a>.
    </p>
  </div>
</MaquettePage>
