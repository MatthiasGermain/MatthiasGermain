---
/* Accueil de la maquette : l'ESP32 en plein écran, sans en-tête. Le nom est gravé sur le blindage ;
 * chaque section est au bout d'une broche et s'ouvre sur sa propre page, avec une transition. */
import '../../styles/maquette.css';
import { DESCRIPTION, buttons, portraitRows, sections } from '../../data/maquette';

// Rangée et place de chaque étiquette sur mobile (carte debout)
const bandOf = (id: string) => {
  for (const band of ['top', 'bottom'] as const) {
    const i = (portraitRows[band] as readonly string[]).indexOf(id);
    if (i >= 0) return { band, order: i };
  }
};

const links = [
  ...sections.map((s) => ({ ...s, action: undefined as 'boot' | 'en' | undefined })),
  { ...buttons.boot, id: 'boot', action: 'boot' as const, led: false },
  { ...buttons.en, id: 'en', action: 'en' as const, led: false },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Matthias Germain - Ingénieur logiciel embarqué et IoT</title>
    <meta name="description" content={DESCRIPTION} />
  </head>
  <body>
    <main id="accueil" class="stage">
      <!-- Le nom est gravé sur le blindage de l'ESP32 ; ce titre reste pour l'accessibilité,
           le référencement et l'affichage sans 3D (mobile). -->
      <h1 class="stage-title display">Matthias <span class="hl">GERMAIN</span></h1>

      <div class="stage-board">
        <div class="esp32-3d" aria-hidden="true"></div>
        <svg class="pinout" aria-hidden="true"></svg>
        <nav class="pin-links" aria-label="Sections, par broche de l'ESP32">
          {
            links.map((l) => (
              <a
                class="pin-link"
                href={l.href}
                data-id={l.id}
                data-side={l.side}
                data-band={bandOf(l.id)?.band}
                data-order={bandOf(l.id)?.order}
                data-pin={'pin' in l.target ? l.target.pin : undefined}
                data-row={'pin' in l.target ? l.target.row : undefined}
                data-feature={'feature' in l.target ? l.target.feature : undefined}
                data-action={l.action}
                data-flash={l.action === 'boot' ? '' : undefined}
                data-led={l.led ? '' : undefined}
              >
                <span class="pin-name">{l.pinLabel}</span>
                <span class="pin-label">{l.label}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Description mise en valeur avec les codes de la DA : accroche (contraste fin / gras +
           surligneur), la chaîne en trois maillons surlignés, puis formation et disponibilité. -->
      <div class="stage-foot">
        <p class="intro-title display">
          <span class="light">Ingénieur logiciel</span> <span class="hl">EMBARQUÉ &amp; IoT</span>
        </p>
        <p class="intro-chain">
          Toute la chaîne d'un système connecté : <span class="hl-soft">le firmware</span>,
          <span class="hl-soft">l'outillage Python</span> qui l'entoure et
          <span class="hl-soft">l'interface web</span>.
        </p>
        <p class="intro-meta">
          <span>Diplômé de TÉLÉCOM Nancy · basé à Strasbourg</span>
          <span class="availability">
            <span class="chip-led" aria-hidden="true"></span>
            <b>Disponible</b> · <time id="today">05 OCT 2026</time>
            <span class="sub">poste embarqué ou web, Strasbourg ou Nancy</span>
          </span>
        </p>
        <p class="stage-hint">
          <span class="credit">Modèle 3D : ESP32 Wroom par TER1Z (CC BY), modifié</span>
        </p>
      </div>
    </main>

    <script>
      import { loadEsp32, createEsp32Scene, type Esp32Model } from '../../lib/esp32-scene';
      import { bindFlashLinks, runFlash } from '../../lib/maquette-flash';
      import { SIGNATURE_PATH, SIGNATURE_VIEWBOX } from '../../data/signature';

      type Point3 = [number, number, number];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      bindFlashLinks();

      // Date du jour dans la ligne « Disponible »
      const today = document.getElementById('today');
      if (today) {
        const now = new Date();
        today.textContent = new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })
          .format(now)
          .replace('.', '')
          .toUpperCase();
        today.setAttribute('datetime', now.toISOString().slice(0, 10));
      }

      const stage = document.querySelector<HTMLElement>('.stage')!;
      const holder = stage.querySelector<HTMLElement>('.esp32-3d')!;
      const svg = stage.querySelector<SVGSVGElement>('.pinout')!;
      const links = Array.from(stage.querySelectorAll<HTMLAnchorElement>('.pin-link'));
      const hasWebGL2 = (() => {
        try {
          return !!document.createElement('canvas').getContext('webgl2');
        } catch {
          return false;
        }
      })();

      // Mise en page selon l'écran : large, la carte couchée avec les étiquettes tout autour ;
      // en hauteur (téléphone), la carte debout entre deux colonnes d'étiquettes ; sinon, sans 3D.
      const wideQuery = matchMedia('(min-width: 900px)');
      const portraitQuery = matchMedia('(orientation: portrait)');
      const modeOf = () => (wideQuery.matches ? 'wide' : portraitQuery.matches ? 'portrait' : 'flat');
      const mode = modeOf();
      const portrait = mode === 'portrait';
      // Changement de mode (rotation du téléphone, fenêtre redimensionnée) : on recharge la page
      for (const q of [wideQuery, portraitQuery]) q.addEventListener('change', () => modeOf() !== mode && location.reload());

      if (hasWebGL2 && mode !== 'flat') {
        const start = () =>
          Promise.all([loadEsp32('/models/esp32.bin'), document.fonts.load('900 40px Avenir'), document.fonts.load('600 20px Montserrat')])
            .then(([model]) => initStage(model))
            .catch((err) => console.warn('ESP32 3D indisponible, accueil sans 3D', err));
        if (document.readyState === 'complete') start();
        else window.addEventListener('load', start, { once: true });
      }

      function initStage(model: Esp32Model) {
        stage.classList.add('has-3d');
        stage.classList.toggle('is-portrait', portrait);
        const NS = 'http://www.w3.org/2000/svg';

        // Chaque lien est rattaché à une broche (ou à un bouton) du modèle
        const items = links.map((a) => {
          const d = a.dataset;
          const point = (d.feature
            ? model.header.features[d.feature as 'boot' | 'en']
            : model.header.pins.find((p) => p.name === d.pin && p.row === d.row)!.pos) as Point3;
          const path = document.createElementNS(NS, 'path');
          const pad = document.createElementNS(NS, 'circle');
          pad.setAttribute('r', '3.5');
          svg.append(path, pad);
          return {
            a,
            point,
            side: d.side as 'top' | 'bottom' | 'left' | 'right',
            band: d.band as 'top' | 'bottom',
            feature: !!d.feature,
            path,
            pad,
            ax: 0,
            ay: 0,
          };
        });
        type Item = (typeof items)[number];
        type Project = (p: Point3) => [number, number];

        // Emprise de la carte à l'écran (coins de la boîte englobante projetés)
        const extent = (project: Project) => {
          const { min, max } = model.header.bbox;
          const xs: number[] = [];
          const ys: number[] = [];
          for (const x of [min[0], max[0]]) for (const y of [min[1], max[1]]) for (const z of [min[2], max[2]]) {
            const [sx, sy] = project([x, y, z]);
            xs.push(sx);
            ys.push(sy);
          }
          return { l: Math.min(...xs), r: Math.max(...xs), t: Math.min(...ys), b: Math.max(...ys) };
        };

        // Carte debout : une rangée de trois étiquettes au-dessus de la carte, une au-dessous. La carte
        // est cadrée dans l'espace qui reste entre les deux rangées.
        const GUTTER = 16;
        const TRACE_GAP = 12;
        const BAND_GAP = 26; // entre une rangée et la carte
        const bandHeight = portrait ? Math.max(...items.map((it) => it.a.offsetHeight)) + GUTTER + BAND_GAP : 0;
        const layoutPortrait = () => {
          const W = stage.clientWidth;
          const H = holder.clientHeight;
          for (const band of ['top', 'bottom'] as const) {
            const group = items.filter((it) => it.band === band);
            group.sort((p, q) => Number(p.a.dataset.order) - Number(q.a.dataset.order));
            const cell = (W - 2 * GUTTER) / group.length;
            group.forEach((it, i) => {
              const w = it.a.offsetWidth;
              const h = it.a.offsetHeight;
              const cx = GUTTER + cell * (i + 0.5);
              const top = band === 'top' ? GUTTER : H - GUTTER - h;
              it.a.style.left = `${cx - w / 2}px`;
              it.a.style.top = `${top}px`;
              it.ax = cx;
              it.ay = band === 'top' ? top + h : top;
            });
          }
        };

        // Piste de la broche à l'étiquette, à angles droits et sans traverser la carte : elle sort sur le
        // côté de la broche, longe la carte jusqu'à l'extrémité de la rangée visée, puis rejoint l'étiquette.
        // Les boutons, sur la carte près de la prise USB, descendent tout droit vers la rangée du bas.
        const routePortrait = (it: Item, px: number, py: number, e: ReturnType<typeof extent>) => {
          const endY = it.band === 'top' ? e.t - TRACE_GAP : e.b + TRACE_GAP;
          if (it.feature) return `M${px} ${py} V${endY} H${it.ax} V${it.ay}`;
          const gx = px < (e.l + e.r) / 2 ? e.l - TRACE_GAP : e.r + TRACE_GAP;
          return `M${px} ${py} H${gx} V${endY} H${it.ax} V${it.ay}`;
        };

        // Placement des étiquettes (au repos, puis après chaque redimensionnement) : au-dessus de la
        // rangée arrière, sous la pointe des broches avant, à gauche pour les boutons, à droite pour Contact.
        let needsLayout = true;
        new ResizeObserver(() => (needsLayout = true)).observe(holder);
        const layout = (project: Project) => {
          if (portrait) return layoutPortrait();
          const W = stage.clientWidth;
          const { min, max } = model.header.bbox;
          const xs: number[] = [];
          for (const x of [min[0], max[0]]) for (const y of [min[1], max[1]]) for (const z of [min[2], max[2]]) xs.push(project([x, y, z])[0]);
          const backY = model.header.pins.filter((p) => p.row === 'back').map((p) => project(p.pos)[1]);
          const tipsY = model.header.pins.filter((p) => p.row === 'front').map((p) => project([p.pos[0], p.pos[1], min[2]])[1]);
          const bottomY = Math.max(...tipsY) + 18;
          const topY = Math.min(...backY) - 46;
          const leftX = Math.min(...xs) - 36;
          const rightX = Math.max(...xs) + 36;

          for (const side of ['left', 'right'] as const) {
            const group = items.filter((it) => it.side === side).sort((p, q) => project(p.point)[1] - project(q.point)[1]);
            let prevBottom = -Infinity;
            for (const it of group) {
              const w = it.a.offsetWidth;
              const h = it.a.offsetHeight;
              const top = Math.max(project(it.point)[1] - h / 2, prevBottom + 10);
              prevBottom = top + h;
              const left = side === 'left' ? leftX - w : rightX;
              it.a.style.left = `${left}px`;
              it.a.style.top = `${top}px`;
              it.ax = side === 'left' ? left + w : left;
              it.ay = top + h / 2;
            }
          }
          for (const side of ['bottom', 'top'] as const) {
            const group = items.filter((it) => it.side === side).sort((p, q) => project(p.point)[0] - project(q.point)[0]);
            let prevRight = 8 - 14;
            const lefts = group.map((it) => {
              const left = Math.max(project(it.point)[0] - it.a.offsetWidth / 2, prevRight + 14);
              prevRight = left + it.a.offsetWidth;
              return left;
            });
            const overflow = Math.max(0, prevRight - (W - 8));
            group.forEach((it, i) => {
              const w = it.a.offsetWidth;
              const h = it.a.offsetHeight;
              const left = lefts[i] - overflow;
              const top = side === 'bottom' ? bottomY : topY - h;
              it.a.style.left = `${left}px`;
              it.a.style.top = `${top}px`;
              it.ax = left + w / 2;
              it.ay = side === 'bottom' ? top : top + h;
            });
          }
        };

        // Pistes : de la broche (qui bouge avec la carte) jusqu'à l'étiquette (fixe), à angles droits
        const route = (it: Item, px: number, py: number) => {
          if (it.side === 'bottom') return `M${px} ${py} V${it.ay - 14} H${it.ax} V${it.ay}`;
          if (it.side === 'top') return `M${px} ${py} V${it.ay + 14} H${it.ax} V${it.ay}`;
          if (it.side === 'left') return `M${px} ${py} H${it.ax + 18} V${it.ay} H${it.ax}`;
          return `M${px} ${py} H${it.ax - 18} V${it.ay} H${it.ax}`;
        };

        // Étiquettes et pistes apparaissent une fois la carte dessinée
        let readyTimer = 0;
        const showPinsLater = () => {
          stage.classList.remove('pins-ready');
          clearTimeout(readyTimer);
          readyTimer = window.setTimeout(() => stage.classList.add('pins-ready'), reduced ? 0 : 1700);
        };
        showPinsLater();

        const chipLed = document.querySelector<HTMLElement>('.chip-led');
        chipLed?.classList.add('is-synced');
        const scene = createEsp32Scene(holder, model, {
          reducedMotion: reduced,
          signaturePath: SIGNATURE_PATH,
          signatureViewBox: SIGNATURE_VIEWBOX,
          // Debout : vue plus plongeante (la carte paraît plus haute), pas de balancement, et rendu
          // arrêté au repos pour ménager la batterie.
          ...(portrait
            ? {
                portrait: true,
                view: { elevation: 65, marginX: 0.12, marginY: Math.min(0.6, (2 * bandHeight) / holder.clientHeight) },
                sway: 0,
                idleStop: true,
              }
            : { view: { elevation: 50, marginX: 0.1, marginY: 0.18 }, sway: 0.05 }),
          onLed: (v) => {
            if (!chipLed) return;
            chipLed.style.opacity = String(0.25 + 0.75 * v);
            chipLed.style.boxShadow = `0 0 0 3px rgba(252, 202, 70, ${0.25 * v}), 0 0 ${10 * v}px rgba(252, 202, 70, ${0.8 * v})`;
          },
          onBoot: () => runFlash('/cv'),
          onRestart: showPinsLater,
          onFrame: (projectInCanvas) => {
            // Le canevas est centré dans la scène, entre les deux colonnes d'étiquettes
            const ox = holder.offsetLeft;
            const oy = holder.offsetTop;
            const project = (p: Point3): [number, number] => {
              const [x, y] = projectInCanvas(p);
              return [x + ox, y + oy];
            };
            if (needsLayout) {
              layout(project);
              needsLayout = false;
            }
            const e = portrait ? extent(project) : null;
            for (const it of items) {
              const [px, py] = project(it.point);
              it.path.setAttribute('d', e ? routePortrait(it, px, py, e) : route(it, px, py));
              it.pad.setAttribute('cx', String(px));
              it.pad.setAttribute('cy', String(py));
            }
          },
        });

        // Survol ou focus d'une étiquette : la broche s'allume (et la LED bleue pour « Projets »)
        const activate = (it: Item, on: boolean) => {
          for (const el of [it.a, it.path, it.pad]) el.classList.toggle('is-hot', on);
          scene.highlight(on ? it.point : null);
          if (it.a.hasAttribute('data-led')) scene.userLed(on);
        };
        for (const it of items) {
          it.a.addEventListener('pointerenter', () => activate(it, true));
          it.a.addEventListener('pointerleave', () => activate(it, false));
          it.a.addEventListener('focus', () => activate(it, true));
          it.a.addEventListener('blur', () => activate(it, false));
          it.a.addEventListener('click', (e) => {
            const action = it.a.dataset.action;
            if (action === 'boot') return; // séquence de flash (bindFlashLinks)
            if (action === 'en') {
              e.preventDefault();
              return scene.restart();
            }
            if (reduced || e.metaKey || e.ctrlKey) return; // lien normal
            e.preventDefault();
            go(it);
          });
        }

        // Vers une page : l'impulsion court de la broche à l'étiquette pendant que la caméra plonge
        // vers la broche ; puis l'étiquette devient le titre de la page (View Transition).
        function go(it: Item) {
          if (portrait) drawTrace(it, () => fire(it));
          else fire(it);
        }
        // Carte debout : la piste se dessine d'abord, de l'étiquette touchée jusqu'à sa broche
        function drawTrace(it: Item, done: () => void) {
          const length = it.path.getTotalLength();
          it.path.style.strokeDasharray = `${length} ${length}`;
          it.path.classList.add('is-drawn');
          const t0 = performance.now();
          const duration = 260;
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / duration);
            it.path.style.strokeDashoffset = String(-length * (1 - k * (2 - k)));
            if (k < 1) return requestAnimationFrame(step);
            it.path.style.strokeDasharray = '';
            it.path.style.strokeDashoffset = '';
            done();
          };
          requestAnimationFrame(step);
        }
        function fire(it: Item) {
          scene.zoomTo(it.point, 650);
          const pulse = document.createElementNS(NS, 'circle');
          pulse.setAttribute('r', '5');
          pulse.classList.add('pulse');
          svg.append(pulse);
          const t0 = performance.now();
          const duration = 380;
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / duration);
            const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
            const p = it.path.getPointAtLength(it.path.getTotalLength() * e);
            pulse.setAttribute('cx', String(p.x));
            pulse.setAttribute('cy', String(p.y));
            if (k < 1) return requestAnimationFrame(step);
            pulse.remove();
            it.a.classList.add('is-firing');
            it.a.style.viewTransitionName = 'section-title';
            setTimeout(() => (location.href = it.a.href), 120);
          };
          requestAnimationFrame(step);
        }

        // Retour arrière depuis une page : la page revient du cache, zoomée ; on remet tout en place
        window.addEventListener('pageshow', (e) => {
          if (!e.persisted) return;
          scene.resetView();
          for (const it of items) {
            it.a.style.viewTransitionName = '';
            it.a.classList.remove('is-firing');
            it.path.classList.remove('is-drawn');
            activate(it, false);
          }
        });
      }
    </script>
  </body>
</html>
