---
/* /routine : le tableau de bord de Matthias avec une session valide (servi à cette même adresse
 * depuis pages/routine/tableau.astro), la vue visiteur (la station connectée) sinon. Rendue côté
 * serveur à chaque visite, et jamais mise en cache : Vercel ne doit pas servir la vue propriétaire
 * à un visiteur. */
export const prerender = false;

import Visitor from '../../components/routine/Visitor.astro';
import { isOwner } from '../../lib/routine-auth';

Astro.response.headers.set('Cache-Control', 'private, no-store');
if (isOwner(Astro.cookies)) return Astro.rewrite('/routine/tableau');
---

<Visitor />
