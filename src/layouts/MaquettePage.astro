---
/* Gabarit des pages du site hors accueil : les sections (Projets, Expériences, Parcours, Contact) et
 * les pages annexes (mentions légales).
 * En-tête : la signature (retour à la carte), la barrette de broches pour passer d'une page à
 * l'autre sans repasser par l'ESP32, et BOOT (mode recruteur). */
import '../styles/maquette.css';
import Signature from '../components/Signature.astro';
import SeoHead from '../components/SeoHead.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { content } from '../data/content';
import type { SectionId } from '../data/maquette';
import { href, langOf, tr } from '../i18n';

interface Props {
  /** Section affichée (allume sa broche dans la barrette) ; absente pour une page annexe */
  current?: SectionId;
  /** Titre et description d'une page annexe, ou d'une page de détail dans une section */
  title?: string;
  description?: string;
  /** Sous-titre sous le titre (par défaut, le « pourquoi » de la broche de la section) */
  subtitle?: string;
}

const { current, title, description, subtitle } = Astro.props;
const lang = langOf(Astro.url);
const t = tr(lang);
const { HOME, buttons, sections } = content(lang);
const section = sections.find((s) => s.id === current);
const pageTitle = title ?? section?.label ?? '';
// Ordre de la barrette : EN (retour à la carte) puis les sections
const strip = [
  { id: 'carte', label: t('Carte', 'Board'), pinLabel: 'EN', href: HOME },
  ...sections.map((s) => ({ id: s.id, label: s.label, pinLabel: s.pinLabel, href: s.href })),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={`${pageTitle} - Matthias Germain`} description={description ?? section?.meta ?? ''} />
  </head>
  <body>
    <header class="page-top">
      <div class="wrap page-top-row">
        <a class="logo" href={HOME} aria-label={t('Matthias Germain, retour à la carte', 'Matthias Germain, back to the board')}>
          <span class="logo-sign" aria-hidden="true"><Signature /></span>
          <span class="logo-bold">GERMAIN</span>
        </a>
        <nav class="strip" aria-label="Sections">
          {
            strip.map((s) => (
              <a class="strip-pin" href={s.href} aria-current={s.id === current ? 'page' : undefined}>
                <span class="pad" aria-hidden="true" />
                <span class="pin-name">{s.pinLabel}</span>
                <span class="strip-label">{s.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="page-top-end">
          <LangSwitch />
          <a class="pill pill-outline boot-link" href={buttons.boot.href} data-flash>
            <span class="pin-name">{buttons.boot.pinLabel}</span>
            <!-- Sur écran étroit, avec le sélecteur de langue, le libellé court tient dans l'en-tête -->
            <span class="boot-long">{buttons.boot.label}</span><span class="boot-short">CV</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap page-head">
        {
          section && (
            <p class="page-pin">
              {t('Broche', 'Pin')} <span class="pin-name">{section.pinLabel}</span>
              {title && <a href={section.href}>{section.label}</a>}
            </p>
          )
        }
        <h1 class="page-title">{pageTitle}</h1>
        {(subtitle ?? section?.why) && <p class="page-why">{subtitle ?? section?.why}</p>}
      </div>
      <slot />
    </main>

    <footer class="wrap page-foot">
      <span>© 2026 Matthias Germain · Strasbourg</span>
      <a href={href(lang, '/mentions-legales')}>{t('Mentions légales et confidentialité', 'Legal notice and privacy')}</a>
    </footer>

    <script>
      import { bindFlashLinks } from '../lib/maquette-flash';

      bindFlashLinks();

      // Barrette : une impulsion court de la broche actuelle vers celle visée, puis on change de page
      const strip = document.querySelector<HTMLElement>('.strip');
      const pins = Array.from(document.querySelectorAll<HTMLAnchorElement>('.strip-pin'));
      const current = pins.find((p) => p.getAttribute('aria-current') === 'page');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const centerOf = (el: HTMLElement) => {
        const pad = el.querySelector<HTMLElement>('.pad')!;
        const s = strip!.getBoundingClientRect();
        const r = pad.getBoundingClientRect();
        return r.left + r.width / 2 - s.left;
      };
      for (const pin of pins) {
        pin.addEventListener('click', (e) => {
          if (!strip || !current || pin === current || reduced || e.metaKey || e.ctrlKey) return;
          e.preventDefault();
          const pulse = document.createElement('span');
          pulse.className = 'strip-pulse';
          pulse.style.left = `${centerOf(current)}px`;
          strip.append(pulse);
          requestAnimationFrame(() => requestAnimationFrame(() => (pulse.style.left = `${centerOf(pin)}px`)));
          setTimeout(() => (location.href = pin.href), 360);
        });
      }
      // Retour arrière : on retire l'impulsion restée affichée
      window.addEventListener('pageshow', () => document.querySelectorAll('.strip-pulse').forEach((p) => p.remove()));
    </script>
  </body>
</html>
