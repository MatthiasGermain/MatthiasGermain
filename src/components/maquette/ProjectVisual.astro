      <text x="134" y="232" class="t muted" text-anchor="middle">STATUTS RÉÉCRITS</text>
    </svg>
  )}
  {visual === 'urbanloop' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Circuit de la maquette UrbanLoop : deux boucles en sens inverse reliées par les aiguillages 101 et 102, deux stations, des capteurs infrarouges et deux capsules">
