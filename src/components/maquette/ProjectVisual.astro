      </defs>
      <g class="s">
        <rect x="8" y="24" width="200" height="214" rx="8" class="dash" />
        <rect x="18" y="40" width="70" height="22" rx="4" class="paper" />
        <rect x="18" y="72" width="70" height="22" rx="4" class="paper" />
        <rect x="18" y="104" width="70" height="22" rx="4" class="paper" />
        <path d="M88 51 H100 V72 H110 M88 83 H110 M88 115 H100 V96 H110" />
        <rect x="112" y="52" width="84" height="56" rx="6" class="paper" />
