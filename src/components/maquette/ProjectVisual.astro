      <text x="66" y="51" class="t muted" text-anchor="middle">LIDAR, CAMÉRAS</text>
      <text x="210" y="36" class="t" text-anchor="middle">DÉTECTION</text>
      <text x="210" y="51" class="t muted" text-anchor="middle">ROS2 · YOLO · VOTE</text>
      <text x="202" y="84" class="t muted" text-anchor="end">SÉRIE</text>
      <text x="202" y="97" class="t" text-anchor="end">GO · SLOW · STOP</text>
      <text x="66" y="137" class="tb" text-anchor="middle">ESP32</text>
      <text x="66" y="152" class="t" text-anchor="middle">RADAR</text>
      <text x="66" y="165" class="t muted" text-anchor="middle">0-255 / 10 S</text>
      <text x="134" y="134" class="t muted" text-anchor="middle">IR</text>
      <text x="210" y="137" class="tb" text-anchor="middle">ESP32</text>
