      <text x="354" y="179" class="tb" text-anchor="middle">API</text>
      <text x="232" y="232" class="t muted">SITE · VERCEL</text>
    </svg>
  )}
  {visual === 'risc' && (
    // Chemin de données simplifié, d'après RISC_V_Processor.vhd : pas de pipeline, une instruction par
    // cycle d'horloge. Pas de mux de branchement devant le PC : les sauts ne sont pas câblés.
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Chemin de données simplifié du processeur RISC-V : PC, mémoire d'instructions, registres, ALU et mémoire de données, avec les cinq étapes d'une instruction dans un seul cycle d'horloge">
