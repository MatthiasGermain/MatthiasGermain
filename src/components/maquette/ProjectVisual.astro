---
// Visuel d'une fiche projet : schéma SVG (embarqué, outillage) ou capture dans un cadre de navigateur
// (web). Le tableau de bord de narthex reste dessiné en attendant une capture avec des données de démo.
import type { Visual } from '../../data/maquette';
import ScrollShot from '../ScrollShot.astro';

interface Props {
  visual: Visual;
}

const { visual } = Astro.props;
---

  {visual === 'routine' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Schéma de routine-station : capteurs, ESP32, moteur et alarme dans la station ; broker MQTT ; page web et API sur le site">
      <defs>
        <marker id="arr-routine" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
