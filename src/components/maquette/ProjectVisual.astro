---
// Visuel d'une fiche projet : schéma SVG (embarqué, outillage) ou capture dans un cadre de navigateur
// (web). Le tableau de bord de narthex reste dessiné en attendant une capture avec des données de démo.
import type { Visual } from '../../data/maquette';

interface Props {
  visual: Visual;
}

const { visual } = Astro.props;
---

  {visual === 'routine' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Schéma de routine-station : capteurs, ESP32, moteur et alarme dans la station ; broker MQTT ; page web et API sur le site">
      <defs>
        <marker id="arr-routine" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <rect x="8" y="24" width="200" height="214" rx="8" class="dash" />
        <rect x="18" y="40" width="70" height="22" rx="4" class="paper" />
        <rect x="18" y="72" width="70" height="22" rx="4" class="paper" />
        <rect x="18" y="104" width="70" height="22" rx="4" class="paper" />
        <path d="M88 51 H100 V72 H110 M88 83 H110 M88 115 H100 V96 H110" />
        <rect x="112" y="52" width="84" height="56" rx="6" class="paper" />
        <path d="M128 108 V150 M177 108 V154" />
        <circle cx="128" cy="168" r="17" class="paper" />
        <rect x="148" y="154" width="58" height="28" rx="4" class="sun" />
        <path d="M198 66 H232" marker-start="url(#arr-routine)" marker-end="url(#arr-routine)" />
        <rect x="234" y="44" width="100" height="40" rx="20" class="paper" />
        <rect x="224" y="118" width="168" height="120" rx="8" class="dash" />
        <path d="M262 84 V146" marker-end="url(#arr-routine)" />
        <rect x="234" y="148" width="74" height="54" rx="4" class="paper" />
        <line x1="234" y1="160" x2="308" y2="160" />
        <path d="M308 176 H322" marker-end="url(#arr-routine)" />
        <rect x="324" y="148" width="60" height="54" rx="4" class="paper" />
        <path d="M354 148 V64 H336" marker-end="url(#arr-routine)" />
      </g>
      <text x="16" y="17" class="t">STATION</text>
      <text x="53" y="55" class="t" text-anchor="middle">TEMP.</text>
      <text x="53" y="87" class="t" text-anchor="middle">LUMIÈRE</text>
      <text x="53" y="119" class="t" text-anchor="middle">FLAMME</text>
      <text x="154" y="80" class="tb" text-anchor="middle">ESP32</text>
      <text x="154" y="97" class="t muted" text-anchor="middle">FREERTOS</text>
      <text x="128" y="173" class="tb" text-anchor="middle">M</text>
      <text x="177" y="172" class="t" text-anchor="middle">ALARME</text>
      <text x="108" y="222" class="t muted" text-anchor="middle">ALARME LOCALE, SANS RÉSEAU</text>
      <text x="284" y="68" class="t" text-anchor="middle">BROKER MQTT</text>
      <text x="284" y="36" class="t muted" text-anchor="middle">HIVEMQ · TLS</text>
      <text x="271" y="186" class="t" text-anchor="middle">PAGE WEB</text>
      <text x="354" y="179" class="tb" text-anchor="middle">API</text>
      <text x="232" y="232" class="t muted">SITE · VERCEL</text>
    </svg>
  )}
  {visual === 'risc' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Chemin de données du processeur RISC-V, sans pipeline">
      <defs>
        <marker id="arr-risc" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <rect x="16" y="105" width="46" height="40" rx="4" class="paper" />
        <rect x="84" y="95" width="66" height="60" rx="4" class="paper" />
        <rect x="176" y="28" width="60" height="34" rx="4" class="paper" />
        <rect x="176" y="100" width="60" height="50" rx="4" class="paper" />
        <rect x="176" y="182" width="60" height="34" rx="4" class="paper" />
        <path d="M246 134 L256 140 L256 156 L246 162 Z" class="paper" />
        <path d="M262 92 L302 112 L302 140 L262 160 L262 136 L272 126 L262 116 Z" class="sun" />
        <rect x="322" y="104" width="62" height="44" rx="4" class="paper" />
        <path d="M304 56 L304 84 L288 76 L288 64 Z" class="paper" />
        <path d="M62 125 H82" marker-end="url(#arr-risc)" />
        <path d="M150 125 H174" marker-end="url(#arr-risc)" />
        <path d="M164 125 V45 H174" marker-end="url(#arr-risc)" />
        <path d="M164 125 V199 H174" marker-end="url(#arr-risc)" />
        <path d="M236 112 H250 V104 H260" marker-end="url(#arr-risc)" />
        <path d="M236 140 H244" marker-end="url(#arr-risc)" />
        <path d="M236 199 H240 V156 H244" marker-end="url(#arr-risc)" />
        <path d="M256 148 H260" />
        <path d="M302 126 H320" marker-end="url(#arr-risc)" />
        <path d="M312 126 V76 H306" marker-end="url(#arr-risc)" />
        <path d="M353 104 V64 H306" marker-end="url(#arr-risc)" />
        <path d="M288 70 H206 V98" marker-end="url(#arr-risc)" />
        <path d="M236 45 H282 V100" class="dash" />
      </g>
      <circle cx="164" cy="125" r="3" class="dot" />
      <circle cx="312" cy="126" r="3" class="dot" />
      <text x="39" y="129" class="t" text-anchor="middle">PC</text>
      <text x="117" y="129" class="t" text-anchor="middle">IMEM</text>
      <text x="206" y="49" class="t" text-anchor="middle">DÉC.</text>
      <text x="206" y="129" class="t" text-anchor="middle">REG</text>
      <text x="206" y="203" class="t" text-anchor="middle">IMM</text>
      <text x="283" y="130" class="t" text-anchor="middle">ALU</text>
      <text x="353" y="124" class="t" text-anchor="middle">MÉM</text>
      <text x="353" y="138" class="t muted" text-anchor="middle">+ LOAD</text>
      <text x="16" y="236" class="t muted">SANS PIPELINE · 1 INSTRUCTION PAR PASSAGE</text>
    </svg>
  )}
  {visual === 'irda' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Schéma IRDA : l'ESP32 radar envoie une consigne par infrarouge à l'ESP32 de la capsule, qui reçoit aussi GO, SLOW et STOP par liaison série">
      <defs>
        <marker id="arr-irda" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <rect x="10" y="96" width="100" height="60" rx="6" class="paper" />
        <path d="M116 116 A12 12 0 0 1 116 136 M124 108 A22 22 0 0 1 124 144 M132 100 A32 32 0 0 1 132 152" />
        <path d="M150 126 H236" class="dash" marker-end="url(#arr-irda)" />
        <rect x="232" y="12" width="160" height="30" rx="4" class="paper dash" />
        <path d="M312 42 V82" marker-end="url(#arr-irda)" />
        <rect x="240" y="86" width="144" height="80" rx="6" class="paper" />
        <path d="M268 166 V196 M312 166 V198 M362 166 V200" />
        <rect x="248" y="196" width="40" height="26" rx="3" class="ink" />
        <circle cx="312" cy="209" r="10" class="sun" />
        <circle cx="362" cy="209" r="8" class="paper" />
      </g>
      <path d="M255 205 H281 M255 213 H273" stroke="var(--cream)" stroke-width="2" stroke-linecap="round" />
      <text x="60" y="123" class="tb" text-anchor="middle">ESP32</text>
      <text x="60" y="141" class="t" text-anchor="middle">RADAR</text>
      <text x="60" y="176" class="t muted" text-anchor="middle">CONSIGNE 0-255</text>
      <text x="60" y="189" class="t muted" text-anchor="middle">TOUTES LES 10 S</text>
      <text x="192" y="114" class="t" text-anchor="middle">INFRAROUGE</text>
      <text x="192" y="144" class="t muted" text-anchor="middle">9600 BAUDS</text>
      <text x="312" y="31" class="t" text-anchor="middle">DÉTECTION D'OBSTACLES</text>
      <text x="304" y="66" class="t" text-anchor="end">GO · SLOW · STOP</text>
      <text x="320" y="66" class="t muted">SÉRIE</text>
      <text x="312" y="111" class="tb" text-anchor="middle">ESP32</text>
      <text x="312" y="127" class="t" text-anchor="middle">CAPSULE</text>
      <text x="312" y="145" class="t muted" text-anchor="middle">TÂCHE FREERTOS</text>
      <text x="312" y="157" class="t muted" text-anchor="middle">VITESSE / 100 MS</text>
      <text x="268" y="238" class="t" text-anchor="middle">OLED</text>
      <text x="312" y="238" class="t" text-anchor="middle">PWM</text>
      <text x="364" y="238" class="t" text-anchor="middle">LED</text>
    </svg>
  )}
  {visual === 'schaeffler' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Les deux chaînes du stage Schaeffler : rapports d'erreurs générés depuis le log de build, et configuration des livraisons vérifiée puis générée">
      <defs>
        <marker id="arr-schaeffler" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <rect x="16" y="40" width="104" height="52" rx="6" class="paper dash" />
        <path d="M120 66 H146" marker-end="url(#arr-schaeffler)" />
        <rect x="148" y="40" width="104" height="52" rx="6" class="sun" />
        <path d="M252 66 H278" marker-end="url(#arr-schaeffler)" />
        <rect x="280" y="40" width="104" height="52" rx="6" class="paper" />
        <rect x="16" y="146" width="104" height="52" rx="6" class="paper dash" />
        <path d="M120 164 H146" marker-end="url(#arr-schaeffler)" />
        <rect x="148" y="146" width="104" height="52" rx="6" class="sun" />
        <path d="M252 172 H278" marker-end="url(#arr-schaeffler)" />
        <rect x="280" y="146" width="104" height="52" rx="6" class="paper" />
        <path d="M200 198 V214 H68 V200" marker-end="url(#arr-schaeffler)" />
      </g>
      <text x="16" y="30" class="t">1 · RAPPORTS D'ERREURS</text>
      <text x="68" y="63" class="t" text-anchor="middle">LOG DE BUILD</text>
      <text x="68" y="78" class="t muted" text-anchor="middle">EHANDBOOK</text>
      <text x="200" y="63" class="t" text-anchor="middle">GÉNÉRATEUR</text>
      <text x="200" y="78" class="t muted" text-anchor="middle">+ WINDCHILL</text>
      <text x="332" y="63" class="t" text-anchor="middle">EXCEL</text>
      <text x="332" y="78" class="t muted" text-anchor="middle">PAR ÉQUIPE</text>
      <text x="16" y="136" class="t">2 · CONFIGURATION DES LIVRAISONS</text>
      <text x="68" y="169" class="t" text-anchor="middle">CONFLUENCE</text>
      <text x="68" y="184" class="t muted" text-anchor="middle">SAISIES</text>
      <text x="200" y="169" class="t" text-anchor="middle">OUTIL PYTHON</text>
      <text x="200" y="184" class="t muted" text-anchor="middle">5 CONTRÔLES</text>
      <text x="332" y="169" class="t" text-anchor="middle">FICHIERS</text>
      <text x="332" y="184" class="t muted" text-anchor="middle">JSON VÉRIFIÉS</text>
      <text x="134" y="232" class="t muted" text-anchor="middle">STATUTS RÉÉCRITS</text>
    </svg>
  )}
  {visual === 'urbanloop' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Schéma de la maquette UrbanLoop : site Flask, serveur Hermes, Wi-Fi vers les capsules et les aiguillages, liaison IrDA entre eux">
      <defs>
        <marker id="arr-urbanloop" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <rect x="16" y="22" width="118" height="54" rx="6" class="paper" />
        <path d="M134 49 H164" marker-end="url(#arr-urbanloop)" />
        <rect x="166" y="22" width="110" height="54" rx="6" class="paper dash" />
        <path d="M221 76 V100 M72 100 H300 M72 100 V138 M300 100 V138" />
        <path d="M72 128 V138" marker-end="url(#arr-urbanloop)" />
        <path d="M300 128 V138" marker-end="url(#arr-urbanloop)" />
        <rect x="16" y="140" width="112" height="58" rx="6" class="paper" />
        <path d="M130 169 H226" class="dash" marker-start="url(#arr-urbanloop)" marker-end="url(#arr-urbanloop)" />
        <rect x="228" y="140" width="144" height="58" rx="6" class="sun" />
        <path d="M372 156 H386 V184 H376" marker-end="url(#arr-urbanloop)" />
      </g>
      <circle cx="221" cy="100" r="3" class="dot" />
      <text x="75" y="46" class="t" text-anchor="middle">SITE FLASK</text>
      <text x="75" y="61" class="t muted" text-anchor="middle">SUPERVISION</text>
      <text x="221" y="46" class="t" text-anchor="middle">HERMES</text>
      <text x="221" y="61" class="t muted" text-anchor="middle">SERVEUR TCP</text>
      <text x="230" y="94" class="t muted">WI-FI</text>
      <text x="72" y="166" class="t" text-anchor="middle">2 CAPSULES</text>
      <text x="72" y="181" class="t muted" text-anchor="middle">ESP32</text>
      <text x="178" y="161" class="t" text-anchor="middle">IRDA</text>
      <text x="300" y="161" class="t" text-anchor="middle">2 AIGUILLAGES</text>
      <text x="300" y="175" class="t muted" text-anchor="middle">ESP32 · FREERTOS</text>
      <text x="300" y="189" class="t muted" text-anchor="middle">MOTEUR PAS À PAS</text>
      <text x="300" y="214" class="t muted" text-anchor="middle">SÉRIE ENTRE AIGUILLAGES</text>
      <text x="16" y="238" class="t muted">EN JAUNE : CONÇU PENDANT LE STAGE · POINTILLÉS : EXISTANT</text>
    </svg>
  )}
  {visual === 'spotify' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Schéma de spotify_report : toutes les heures, les écoutes sont récupérées et enregistrées ; une fois par jour, le rapport de la veille part par email">
      <defs>
        <marker id="arr-spotify" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 Z" class="ink" />
        </marker>
      </defs>
      <g class="s">
        <circle cx="30" cy="34" r="12" class="paper" />
        <path d="M30 27 V34 H36" />
        <rect x="10" y="62" width="380" height="150" rx="8" class="dash" />
        <circle cx="58" cy="125" r="32" class="paper" />
        <path d="M120 98 H172 L186 112 V152 H120 Z" class="paper" />
        <path d="M172 98 V112 H186 M130 122 H174 M130 132 H174 M130 142 H162" />
        <rect x="222" y="98" width="74" height="54" rx="4" class="paper" />
        <rect x="326" y="104" width="58" height="42" rx="3" class="paper" />
        <path d="M326 106 L355 128 L384 106" />
        <path d="M90 125 H116" marker-end="url(#arr-spotify)" />
        <path d="M188 125 H218" marker-end="url(#arr-spotify)" />
        <path d="M296 125 H322" marker-end="url(#arr-spotify)" />
      </g>
      <rect x="234" y="128" width="8" height="16" class="sun" />
      <rect x="248" y="118" width="8" height="26" class="sun" />
      <rect x="262" y="124" width="8" height="20" class="sun" />
      <rect x="276" y="112" width="8" height="32" class="sun" />
      <text x="50" y="38" class="t">TOUTES LES HEURES · GITHUB ACTIONS</text>
      <text x="58" y="123" class="tb" text-anchor="middle">API</text>
      <text x="58" y="139" class="t" text-anchor="middle">SPOTIFY</text>
      <text x="58" y="176" class="t muted" text-anchor="middle">50 DERNIÈRES</text>
      <text x="58" y="189" class="t muted" text-anchor="middle">ÉCOUTES</text>
      <text x="153" y="172" class="t" text-anchor="middle">CSV / JOUR</text>
      <text x="153" y="185" class="t muted" text-anchor="middle">SANS DOUBLONS</text>
      <text x="259" y="172" class="t" text-anchor="middle">RAPPORT</text>
      <text x="259" y="185" class="t muted" text-anchor="middle">DE LA VEILLE</text>
      <text x="355" y="172" class="t" text-anchor="middle">E-MAIL</text>
      <text x="355" y="185" class="t muted" text-anchor="middle">1 PAR JOUR</text>
      <text x="18" y="232" class="t muted">RUNNER AUTO-HÉBERGÉ</text>
    </svg>
  )}
  {visual === 'narthex' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Aperçu du tableau de bord de narthex">
      <g class="s">
        <rect x="20" y="18" width="360" height="214" rx="10" class="paper" />
        <line x1="20" y1="44" x2="380" y2="44" />
        <rect x="130" y="25" width="180" height="12" rx="6" />
        <line x1="96" y1="44" x2="96" y2="232" />
        <rect x="108" y="86" width="80" height="54" rx="4" />
        <rect x="198" y="86" width="80" height="54" rx="4" />
        <rect x="288" y="86" width="80" height="54" rx="4" />
        <rect x="108" y="152" width="260" height="68" rx="4" />
      </g>
      <circle cx="36" cy="31" r="3.5" class="dot" />
      <circle cx="48" cy="31" r="3.5" class="dot" />
      <circle cx="60" cy="31" r="3.5" class="dot" />
      <text x="220" y="34" class="t url" text-anchor="middle">narthex.dev</text>
      <rect x="28" y="58" width="60" height="14" rx="3" class="sun" />
      <rect x="34" y="62" width="40" height="6" rx="3" class="ink-soft" />
      <rect x="34" y="82" width="44" height="6" rx="3" class="ink-soft" />
      <rect x="34" y="98" width="36" height="6" rx="3" class="ink-soft" />
      <rect x="34" y="114" width="42" height="6" rx="3" class="ink-soft" />
      <text x="108" y="72" class="t">TABLEAU DE BORD</text>
      <rect x="118" y="112" width="24" height="16" rx="2" class="sun" />
      <rect x="118" y="100" width="40" height="5" rx="2.5" class="ink-soft" />
      <rect x="208" y="100" width="44" height="5" rx="2.5" class="ink-soft" />
      <rect x="298" y="100" width="36" height="5" rx="2.5" class="ink-soft" />
      <rect x="208" y="112" width="30" height="16" rx="2" class="violet" />
      <rect x="298" y="112" width="50" height="16" rx="2" class="indigo-fill" />
      <rect x="120" y="166" width="200" height="6" rx="3" class="ink-soft" />
      <rect x="120" y="182" width="170" height="6" rx="3" class="ink-soft" />
      <rect x="120" y="198" width="186" height="6" rx="3" class="ink-soft" />
    </svg>
  )}
  {visual === 'spotweb' && (
    <svg class="vis-svg" viewBox="0 0 400 250" role="img" aria-label="Capture de la page d'accueil de spotlightcrea.fr">
      <defs>
        <clipPath id="clip-spotweb"><path d="M21 45 H379 V222 a9 9 0 0 1 -9 9 H30 a9 9 0 0 1 -9 -9 Z" /></clipPath>
      </defs>
      <rect x="20" y="18" width="360" height="214" rx="10" class="paper" />
      <image href="/images/spotlightcrea.webp" x="21" y="45" width="358" height="186" preserveAspectRatio="xMidYMin slice" clip-path="url(#clip-spotweb)" />
      <g class="s">
        <rect x="20" y="18" width="360" height="214" rx="10" />
        <line x1="20" y1="44" x2="380" y2="44" />
        <rect x="130" y="25" width="180" height="12" rx="6" />
      </g>
      <circle cx="36" cy="31" r="3.5" class="dot" />
      <circle cx="48" cy="31" r="3.5" class="dot" />
      <circle cx="60" cy="31" r="3.5" class="dot" />
      <text x="220" y="34" class="t url" text-anchor="middle">spotlightcrea.fr</text>
    </svg>
  )}
