      <text x="66" y="51" class="t muted" text-anchor="middle">{t('LIDAR, CAMÉRAS', 'LIDAR, CAMERAS')}</text>
      <text x="210" y="36" class="t" text-anchor="middle">{t('DÉTECTION', 'DETECTION')}</text>
      <text x="210" y="51" class="t muted" text-anchor="middle">ROS2 · YOLO · VOTE</text>
