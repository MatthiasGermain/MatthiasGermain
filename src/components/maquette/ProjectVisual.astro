        <path d="M126 88 H156" marker-end="url(#arr-risc)" />
        <path d="M126 106 H156" marker-end="url(#arr-risc)" />
        <path d="M126 126 H208" marker-end="url(#arr-risc)" />
        <path d="M196 67 H230" marker-end="url(#arr-risc)" />
        <path d="M196 108 H208" marker-end="url(#arr-risc)" />
        <path d="M220 117 H230" marker-end="url(#arr-risc)" />
        <path d="M272 92 H298" marker-end="url(#arr-risc)" />
        <path d="M344 92 H362 V34 H177 V54" marker-end="url(#arr-risc)" />
        <path d="M40 180 H390" marker-end="url(#arr-risc)" />
        <path d="M28 212 H40 V196 H216 V212 H390 V196 H396" />
      </g>
