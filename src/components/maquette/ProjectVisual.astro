      <circle cx="222" cy="164" r="7" class="sun" stroke="var(--ink)" stroke-width="2" />
      <text x="176" y="62" class="t">101</text>
      <text x="230" y="180" class="t">102</text>
      <text x="128" y="136" class="t" text-anchor="middle">BOUCLE 1</text>
      <text x="270" y="136" class="t" text-anchor="middle">BOUCLE 2</text>
      <text x="30" y="128" class="t" text-anchor="middle">STATION</text>
      <text x="30" y="141" class="t muted" text-anchor="middle">141</text>
      <text x="371" y="128" class="t" text-anchor="middle">STATION</text>
      <text x="371" y="141" class="t muted" text-anchor="middle">142</text>
      <path d="M8 244 l4 -7 l4 7 z" class="ink" />
