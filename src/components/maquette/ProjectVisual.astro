        <circle cx="104" cy="180" r="3.5" />
        <circle cx="175" cy="180" r="3.5" />
        <circle cx="253" cy="180" r="3.5" />
        <circle cx="317" cy="180" r="3.5" />
      </g>
      <text x="29" y="91" class="t" text-anchor="middle">PC</text>
      <text x="54" y="139" class="t" text-anchor="middle">+4</text>
      <text x="105" y="99" class="t" text-anchor="middle">IMEM</text>
      <text x="177" y="93" class="t" text-anchor="middle">REG</text>
      <text x="254" y="96" class="t" text-anchor="middle">ALU</text>
      <text x="322" y="96" class="t" text-anchor="middle">DMEM</text>
