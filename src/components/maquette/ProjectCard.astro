---
// Fiche projet, présentée comme une fiche technique (référence, rôle, contexte, stack, liens).
import ProjectVisual from './ProjectVisual.astro';
import StackChips from '../StackChips.astro';
import { refOf, type Project } from '../../data/maquette';
import { content } from '../../data/content';
import { langOf, tr } from '../../i18n';

interface Props {
  project: Project;
  flip?: boolean;
}

const { project: p, flip = false } = Astro.props;
const lang = langOf(Astro.url);
const t = tr(lang);
const { catLabel } = content(lang);
---

<article class:list={['proj', { flip, 'is-case': p.experience }]} data-cats={p.cats.join(' ')}>
  <div class="proj-visual">
    <ProjectVisual visual={p.visual} />
    {p.visualNote && <span class="ph-tag">{p.visualNote}</span>}
  </div>

  <div class="proj-sheet">
    <p class="proj-ref">
      {p.experience && <span class="case-tag">{p.experience}</span>}
      <span>{refOf(p)}</span>
      <span class="sep">·</span>
      <span>{p.cats.map((c) => catLabel[c]).join(' · ')}</span>
      {p.status && <span class="status-tag">{p.status}</span>}
    </p>
    <h2 class="proj-title">{p.title}</h2>
    <p class="proj-pitch">{p.pitch}</p>
    <dl class="spec">
      <div>
        <dt>{t('Rôle', 'Role')}</dt>
        <dd>{p.role}</dd>
      </div>
      <div>
        <dt>{t('Contexte', 'Context')}</dt>
        <dd>{p.context}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>
          <StackChips items={p.stack} />
        </dd>
      </div>
    </dl>
    <p class="proj-links">
      {
        p.caseHref && (
          <a class="pill pill-solid pill-sm" href={p.caseHref}>
            {t('Lire la présentation détaillée', 'Read the full write-up')} →
          </a>
        )
      }
      {
        p.repo ? (
          <a class="pill pill-outline pill-sm" href={p.repo}>
            Code ↗
          </a>
        ) : (
          <span class="proj-note">{p.codeNote ?? t('Code propriétaire : pas de dépôt public', 'Proprietary code: no public repository')}</span>
        )
      }
      {
        p.site && (
          <a class="pill pill-outline pill-sm" href={p.site.url}>
            {p.site.label} ↗
          </a>
        )
      }
    </p>
  </div>
</article>
