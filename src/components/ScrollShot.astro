---
/* Capture pleine page d'un site dans un cadre de navigateur où l'on peut faire défiler la page
 * d'accueil. L'image n'est chargée qu'à l'approche de la fiche (loading="lazy"). */
interface Props {
  src: string;
  url: string;
  alt: string;
  width: number;
  height: number;
}

const { src, url, alt, width, height } = Astro.props;
---

<div class="browser">
  <div class="browser-bar" aria-hidden="true">
    <span class="browser-dots"><i></i><i></i><i></i></span>
    <span class="browser-url">{url}</span>
  </div>
  <div class="browser-view" tabindex="0" role="region" aria-label={`${alt} : faites défiler pour voir toute la page`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
</div>
