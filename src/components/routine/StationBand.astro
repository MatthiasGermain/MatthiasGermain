---
/* Bandeau Station : les mesures de routine-station en direct (MQTT dans le navigateur, voir
 * lib/station/client.ts). Deux formats :
 * - `compact` : en haut du tableau de bord (vue propriétaire), dans son style verre, thèmes clair et
 *   sombre ;
 * - `full` : la vue visiteur, en grand, avec les événements reçus depuis l'ouverture de la page.
 * Avec `controls` (vue propriétaire seulement, rendue pour une session valide), les commandes de la
 * station : moteur, alarme, seuil de température (étape 5, route pages/api/station/command.ts).
 * Le serveur ne rend que la structure et les libellés ; tout le reste est rempli par le script. */
import { langOf, tr } from '../../i18n';
import { THRESHOLD_MAX, THRESHOLD_MIN } from '../../lib/station/protocol';

interface Props {
  variant: 'compact' | 'full';
  /** Boutons de commande : seulement dans la vue propriétaire (en français) */
  controls?: boolean;
}

const { variant, controls = false } = Astro.props;
const lang = langOf(Astro.url);
const t = tr(lang);

// Textes affichés par le script, dans la langue de la page
const strings = {
  locale: lang === 'en' ? 'en-GB' : 'fr-FR',
  connecting: t('Connexion au broker…', 'Connecting to the broker…'),
  reconnecting: t('Broker injoignable, nouvel essai…', 'Broker unreachable, retrying…'),
  unconfigured: t('Affichage en direct indisponible.', 'Live display unavailable.'),
  waiting: t('En attente de la station…', 'Waiting for the station…'),
  online: t('En ligne', 'Online'),
  offline: t('Hors ligne', 'Offline'),
  offlineSince: t('Hors ligne depuis {t}', 'Offline since {t}'),
  reading: t('Mesure de {t}', 'Reading from {t}'),
  timeUnknown: t("heure de la station inconnue", 'station time unknown'),
  uptime: t('allumée depuis {d}', 'up for {d}'),
  alarm: {
    off: t('Au repos', 'Idle'),
    on: t('Déclenché', 'Triggered'),
    silenced: t('Déclenché, buzzer coupé', 'Triggered, buzzer off'),
    test: t('Test en cours', 'Test running'),
  },
  motor: {
    stopped: t('Arrêté', 'Stopped'),
    forward: t('Avant', 'Forward'),
    backward: t('Arrière', 'Backward'),
    locked: t('Bloqué', 'Locked'),
  },
  signal: { good: t('bon', 'good'), fair: t('moyen', 'fair'), weak: t('faible', 'weak') },
  raised: t("Arrêt d'urgence à {t}, réaction {r} µs", 'Emergency stop at {t}, {r} µs reaction'),
  cleared: t('Réarmé sur place à {t}', 'Reset on site at {t}'),
  threshold: t('seuil {s} °C', 'threshold {s} °C'),
  aboveThreshold: t('au-dessus du seuil de {s} °C', 'above the {s} °C threshold'),
  tempHigh: t('Température au-dessus du seuil à {t} : {v} °C (seuil {s} °C)', 'Temperature above the threshold at {t}: {v} °C (threshold {s} °C)'),
  tempNormal: t('Température revenue sous le seuil à {t} : {v} °C (seuil {s} °C)', 'Temperature back below the threshold at {t}: {v} °C (threshold {s} °C)'),
};

// Boutons de la vue propriétaire : la commande envoyée à la route, et son nom dans les retours
const buttons = [
  {
    group: 'Moteur',
    items: [
      { label: 'Avant', feedback: 'Moteur en avant', cmd: { type: 'motor', action: 'start', direction: 'forward' } },
      { label: 'Arrière', feedback: 'Moteur en arrière', cmd: { type: 'motor', action: 'start', direction: 'backward' } },
      { label: 'Stop', feedback: 'Arrêt du moteur', cmd: { type: 'motor', action: 'stop' } },
    ],
  },
  {
    group: 'Alarme',
    items: [
      { label: "Tester l'alarme", feedback: "Test de l'alarme", cmd: { type: 'alarm', action: 'test' } },
      { label: 'Couper le buzzer', feedback: 'Coupure du buzzer', cmd: { type: 'alarm', action: 'silence' } },
    ],
  },
];

const cards = [
  { field: 'temperature', label: t('Température', 'Temperature') },
  { field: 'light', label: t('Lumière', 'Light') },
  { field: 'alarm', label: t("Arrêt d'urgence", 'Emergency stop') },
  { field: 'motor', label: t('Moteur', 'Motor') },
  { field: 'signal', label: t('Signal Wi-Fi', 'Wi-Fi signal') },
];
---

<section
  class:list={['station', `station--${variant}`, 'is-waiting']}
  data-station
  data-strings={JSON.stringify(strings)}
  aria-label={t('La station en direct', 'The station, live')}
>
  <header class="station-head">
    <span class="station-led" aria-hidden="true"></span>
    <p class="station-state" aria-live="polite">{strings.connecting}</p>
    <p class="station-time"></p>
  </header>

  <div class="station-cards">
    {
      cards.map((c) => (
        <div class="station-card" data-field={c.field}>
          <span class="card-label">{c.label}</span>
          <span class="card-value">--</span>
          <span class="card-note" />
        </div>
      ))
    }
  </div>

  {
    controls && (
      <div class="station-controls" data-controls>
        {
          buttons.map((g) => (
            <div class="ctl-group" role="group" aria-label={g.group}>
              <span class="ctl-label">{g.group}</span>
              {g.items.map((b) => (
                <button type="button" class="ctl-btn" data-cmd={JSON.stringify(b.cmd)} data-feedback={b.feedback} disabled>
                  {b.label}
                </button>
              ))}
            </div>
          ))
        }
        <form class="ctl-group" data-threshold>
          <label class="ctl-label" for="station-threshold">Seuil</label>
          <input
            id="station-threshold"
            class="ctl-input"
            type="number"
            min={THRESHOLD_MIN}
            max={THRESHOLD_MAX}
            step="1"
            required
            disabled
          />
          <span class="ctl-unit">°C</span>
          <button type="submit" class="ctl-btn" disabled>Régler</button>
        </form>
        <p class="ctl-feedback" aria-live="polite"></p>
      </div>
    )
  }

  {
    variant === 'full' && (
      <div class="station-events">
        <h3>{t('Derniers événements', 'Latest events')}</h3>
        <ol class="events-list" aria-live="polite">
          <li class="events-empty">{t("Aucun événement depuis l'ouverture de la page.", 'No event since this page was opened.')}</li>
        </ol>
      </div>
    )
  }
</section>

<script>
  import { watchStation, isLive, type StationState } from '../../lib/station/client';
  import { REFUSALS } from '../../lib/station/commands';
  import type { Reply } from '../../lib/station/protocol';

  type Strings = {
    locale: string;
    alarm: Record<string, string>;
    motor: Record<string, string>;
    signal: Record<string, string>;
    [key: string]: string | Record<string, string>;
  };

  const roots = [...document.querySelectorAll<HTMLElement>('[data-station]')];
  if (roots.length) {
    let last: StationState | null = null;

    const fill = (s: string, values: Record<string, string | number>) =>
      s.replace(/\{(\w+)\}/g, (_, k: string) => String(values[k] ?? ''));
    const clock = (ms: number, locale: string, seconds = false) =>
      new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit', ...(seconds && { second: '2-digit' }) }).format(ms);
    const duration = (s: number) => {
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      return h ? `${h} h ${m} min` : m ? `${m} min` : `${s} s`;
    };
    const signal = (dbm: number) => (dbm >= -60 ? 'good' : dbm >= -70 ? 'fair' : 'weak');

    const render = (root: HTMLElement, s: StationState) => {
      const str = JSON.parse(root.dataset.strings!) as Strings;
      const text = (k: string) => str[k] as string;
      const now = Date.now();
      const live = isLive(s, now);
      const m = s.measurement;
      const alarm = m?.alarm ?? 'off';

      // État général : connexion au broker, puis station en ligne ou non
      let state: string;
      if (s.broker === 'unconfigured') state = text('unconfigured');
      else if (s.broker !== 'connected') state = text(s.broker);
      else if (live) state = text('online');
      else if (!m && s.online === null) state = text('waiting');
      else if (s.measuredAt) state = fill(text('offlineSince'), { t: clock(s.measuredAt, str.locale) });
      else state = text('offline');

      root.classList.toggle('is-waiting', !m);
      root.classList.toggle('is-live', live);
      root.classList.toggle('is-stale', !!m && !live);
      root.dataset.alarm = alarm;
      root.classList.toggle('is-temp-high', !!m?.temperature_high);
      root.querySelector('.station-state')!.textContent = state;

      // Heure de la mesure (heure de la station si elle la connaît) et durée depuis le démarrage
      const timeEl = root.querySelector('.station-time')!;
      if (m) {
        const at = m.time ? clock(Date.parse(m.time), str.locale, true) : text('timeUnknown');
        const parts = [fill(text('reading'), { t: at })];
        if (root.classList.contains('station--full')) parts.push(fill(text('uptime'), { d: duration(m.uptime_s) }));
        timeEl.textContent = parts.join(' · ');
      } else timeEl.textContent = '';

      const set = (field: string, value: string) => {
        root.querySelector(`[data-field="${field}"] .card-value`)!.textContent = value;
      };
      if (m) {
        const number = new Intl.NumberFormat(str.locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
        set('temperature', `${number.format(m.temperature_c)} °C`);
        // Seuil d'alerte (firmware de l'étape 5) : sous la valeur, ou l'alerte quand on le dépasse
        const th = m.temperature_threshold_c;
        root.querySelector('[data-field="temperature"] .card-note')!.textContent =
          th === undefined ? '' : fill(text(m.temperature_high ? 'aboveThreshold' : 'threshold'), { s: th });
        set('light', `${m.light_pct} %`);
        set('alarm', str.alarm[m.alarm]);
        set('motor', str.motor[m.motor]);
        set('signal', `${m.rssi_dbm} dBm`);
        root.querySelector('[data-field="signal"] .card-note')!.textContent = str.signal[signal(m.rssi_dbm)];
      }

      // Événements reçus depuis l'ouverture de la page (vue visiteur)
      const list = root.querySelector('.events-list');
      if (list && s.events.length) {
        list.replaceChildren(
          ...s.events.map(({ event, receivedAt }) => {
            const li = document.createElement('li');
            const at = clock(event.time ? Date.parse(event.time) : receivedAt, str.locale, true);
            li.className = `event event--${event.type}`;
            const number = new Intl.NumberFormat(str.locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
            li.textContent =
              event.type === 'alarm_raised'
                ? fill(text('raised'), { t: at, r: event.reaction_us })
                : event.type === 'alarm_cleared'
                  ? fill(text('cleared'), { t: at })
                  : fill(text(event.type === 'temperature_high' ? 'tempHigh' : 'tempNormal'), {
                      t: at,
                      v: number.format(event.temperature_c),
                      s: event.threshold_c,
                    });
            return li;
          }),
        );
      }
    };

    // ---- Commandes (vue propriétaire) ----
    // Chaque commande part vers la route du site, qui renvoie son id ; la réponse de la station arrive
    // par le topic replies et se retrouve par cet id. Sans réponse en 10 s, on le dit.
    const panel = document.querySelector<HTMLElement>('[data-controls]');
    const feedbackEl = panel?.querySelector<HTMLElement>('.ctl-feedback');
    const form = panel?.querySelector<HTMLFormElement>('[data-threshold]');
    const input = form?.querySelector<HTMLInputElement>('input');
    const REPLY_TIMEOUT_MS = 10_000;
    const pending = new Map<string, { label: string; timer: number }>();
    const early = new Map<string, Reply>(); // réponses arrivées avant la réponse de la route

    const feedback = (message: string, state: 'pending' | 'ok' | 'refused') => {
      if (!feedbackEl) return;
      feedbackEl.textContent = message;
      feedbackEl.dataset.state = state;
    };
    const settle = (id: string, label: string, reply: Reply) => {
      clearTimeout(pending.get(id)?.timer);
      pending.delete(id);
      if (reply.ok) feedback(`${label} : fait.`, 'ok');
      else feedback(`${label} : refusé, ${REFUSALS[reply.error ?? ''] ?? reply.error ?? 'sans motif'}.`, 'refused');
    };
    const onReply = (reply: Reply) => {
      if (!reply.id) return;
      const wait = pending.get(reply.id);
      if (wait) settle(reply.id, wait.label, reply);
      else {
        early.set(reply.id, reply);
        if (early.size > 20) early.delete(early.keys().next().value!);
      }
    };
    const ROUTE_ERRORS: Record<number, string> = {
      401: 'session expirée, reconnectez-vous',
      403: 'origine refusée',
      413: 'commande trop longue',
      415: 'format refusé',
      502: "broker injoignable, rien n'est parti",
      503: 'commandes non configurées sur le serveur',
      504: "le broker n'a pas confirmé à temps ; vérifiez l'état de la station avant de réessayer",
    };

    const send = async (command: object, label: string) => {
      feedback(`${label} : envoi…`, 'pending');
      let res: Response;
      try {
        res = await fetch('/api/station/command', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(command),
        });
      } catch {
        feedback(`${label} : réseau indisponible, rien n'est parti.`, 'refused');
        return;
      }
      const data: { id?: string; error?: string } = await res.json().catch(() => ({}));
      if (res.status !== 202 || !data.id) {
        const reason = (res.status === 400 && REFUSALS[data.error ?? '']) || ROUTE_ERRORS[res.status] || `erreur ${res.status}`;
        feedback(`${label} : refusé, ${reason}.`, 'refused');
        return;
      }
      const id = data.id;
      const already = early.get(id);
      pending.set(id, {
        label,
        timer: window.setTimeout(() => {
          pending.delete(id);
          feedback(
            `${label} : pas de réponse en 10 s. Station hors ligne ? Une commande envoyée hors ligne est perdue, elle ne s'exécutera pas plus tard.`,
            'refused',
          );
        }, REPLY_TIMEOUT_MS),
      });
      if (already) settle(id, label, already);
      else feedback(`${label} : envoyée, en attente de la station…`, 'pending');
    };

    panel?.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((btn) =>
      btn.addEventListener('click', () => send(JSON.parse(btn.dataset.cmd!), btn.dataset.feedback!)),
    );
    input?.addEventListener('input', () => (input.dataset.dirty = '1'));
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = Number(input!.value);
      if (!Number.isInteger(value) || value < Number(input!.min) || value > Number(input!.max)) {
        feedback(`Seuil : entre ${input!.min} et ${input!.max} °C, sans décimale.`, 'refused');
        return;
      }
      delete input!.dataset.dirty;
      send({ type: 'threshold', action: 'set', temperature_c: value }, `Seuil à ${value} °C`);
    });

    // Boutons selon l'état : confort seulement, c'est la station qui décide
    const updateControls = (s: StationState) => {
      if (!panel) return;
      const live = isLive(s);
      const alarm = s.measurement?.alarm ?? 'off';
      const locked = alarm !== 'off';
      panel.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((btn) => {
        const c = JSON.parse(btn.dataset.cmd!);
        let enabled = live;
        if (c.type === 'motor' && c.action === 'start') enabled &&= !locked;
        if (c.type === 'alarm' && c.action === 'test') enabled &&= !locked;
        if (c.type === 'alarm' && c.action === 'silence') enabled &&= alarm === 'on' || alarm === 'test';
        btn.disabled = !enabled;
        if (c.type === 'motor' && c.action === 'start') btn.setAttribute('aria-pressed', String(s.measurement?.motor === c.direction));
      });
      form!.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button').forEach((el) => (el.disabled = !live));
      const th = s.measurement?.temperature_threshold_c;
      if (th !== undefined && document.activeElement !== input && !input!.dataset.dirty) input!.value = String(th);
    };

    // Le seuil en vigueur, transmis au graphe de température de la vue visiteur (StationHistory)
    let lastThreshold: number | null = null;
    const renderAll = (s: StationState) => {
      last = s;
      roots.forEach((root) => render(root, s));
      updateControls(s);
      const threshold = s.measurement?.temperature_threshold_c ?? null;
      if (threshold !== lastThreshold) {
        lastThreshold = threshold;
        document.dispatchEvent(new CustomEvent('station:threshold', { detail: threshold }));
      }
    };
    watchStation(renderAll, panel ? onReply : undefined);
    // Le passage à « hors ligne » vient du temps qui passe, pas d'un message : on revérifie chaque seconde
    setInterval(() => last && renderAll(last), 1000);
  }
</script>

<style>
  /* ---- Commun ---- */
  .station { display: grid; gap: 14px; }
  .station-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .station-led { flex: none; width: 10px; height: 10px; border-radius: 50%; background: #9aa0b4; }
  .station.is-live .station-led { background: #fcca46; box-shadow: 0 0 0 3px rgba(252, 202, 70, 0.3); animation: station-led 2.4s ease-in-out infinite; }
  .station[data-alarm='on'] .station-led, .station[data-alarm='silenced'] .station-led { background: #d92d20; box-shadow: 0 0 0 3px rgba(217, 45, 32, 0.25); }
  .station-state { font-weight: 700; }
  .station-time { font-size: 13px; opacity: 0.75; }
  .station-cards { display: grid; gap: 12px; transition: opacity 0.3s, filter 0.3s; }
  .station-card { display: grid; gap: 4px; min-width: 0; }
  .card-label { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .card-value { font-weight: 800; overflow-wrap: anywhere; }
  /* Précision sous la valeur (qualité du signal Wi-Fi) */
  .card-note { font-size: 12px; font-weight: 600; opacity: 0.7; }
  .card-note:empty { display: none; }
  /* Mesure périmée ou station hors ligne : on garde les dernières valeurs, grisées */
  .station.is-stale .station-cards, .station.is-waiting .station-cards { opacity: 0.45; filter: grayscale(1); }
  /* Arrêt d'urgence : la carte passe au rouge (orange quand le buzzer est coupé), le test au jaune */
  .station[data-alarm='on'] [data-field='alarm'] { background: #d92d20; border-color: #d92d20; color: #fff; }
  .station[data-alarm='silenced'] [data-field='alarm'] { background: #f79009; border-color: #f79009; color: #1e2952; }
  .station[data-alarm='test'] [data-field='alarm'] { background: #fcca46; border-color: #fcca46; color: #1e2952; }
  @keyframes station-led { 50% { opacity: 0.45; } }
  @media (prefers-reduced-motion: reduce) { .station-led { animation: none !important; } }

  /* ---- Vue visiteur : en grand, aux couleurs du site ---- */
  .station--full { gap: 20px; color: var(--ink); }
  .station--full .station-state { font-family: var(--font-display); font-size: clamp(20px, 2.4vw, 28px); font-weight: 900; text-transform: uppercase; }
  .station--full .station-time { width: 100%; font-weight: 600; color: var(--ink-70); opacity: 1; }
  .station--full .station-led { width: 14px; height: 14px; }
  .station--full .station-cards { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; }
  .station--full .station-card { padding: 16px 18px; border: 2px solid var(--ink); border-radius: 12px; background: var(--paper); }
  .station--full .card-label { color: var(--ink-70); opacity: 1; }
  .station--full .card-value { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); line-height: 1.15; }
  .station--full[data-alarm='on'] [data-field='alarm'] .card-label,
  .station--full[data-alarm='silenced'] [data-field='alarm'] .card-label,
  .station--full[data-alarm='test'] [data-field='alarm'] .card-label { color: inherit; opacity: 0.85; }
  .station-events h3 { margin-bottom: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-70); }
  .events-list { display: grid; gap: 6px; padding: 0; list-style: none; font-size: 15px; }
  .events-empty { color: var(--ink-70); }
  .event { position: relative; padding-left: 22px; }
  .event::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 10px; height: 10px; border-radius: 50%; background: var(--sun); border: 2px solid var(--ink); }
  .event--alarm_raised::before { background: #d92d20; }

  /* Alerte de température : la carte passe à l'orange (supervision, pas arrêt d'urgence) */
  .station.is-temp-high [data-field='temperature'] { border-color: #f79009; box-shadow: inset 0 0 0 2px #f79009; }
  .station.is-temp-high [data-field='temperature'] .card-note { color: #b54708; opacity: 1; font-weight: 700; }

  /* ---- Commandes (vue propriétaire) ---- */
  .station-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; }
  .ctl-group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .ctl-label { margin-right: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .ctl-btn, .ctl-input {
    height: 32px; padding: 0 12px; border-radius: 16px; font: inherit; font-size: 13px; font-weight: 600;
    color: inherit; border: 1px solid var(--glass-border); background: var(--glass-soft);
  }
  .ctl-btn { cursor: pointer; transition: transform 0.15s, background-color 0.15s; }
  .ctl-btn:hover:not(:disabled) { transform: translateY(-1px); background: var(--glass); }
  .ctl-btn[aria-pressed='true'] { background: #fcca46; border-color: #fcca46; color: #1e2952; }
  .ctl-btn:disabled, .ctl-input:disabled { opacity: 0.4; cursor: not-allowed; }
  .ctl-input { width: 64px; padding: 0 10px; text-align: center; }
  .ctl-unit { font-size: 13px; font-weight: 600; }
  .ctl-feedback { width: 100%; min-height: 1.2em; font-size: 13px; font-weight: 600; }
  .ctl-feedback[data-state='pending'] { opacity: 0.75; }
  .ctl-feedback[data-state='ok'] { color: #067647; }
  .ctl-feedback[data-state='refused'] { color: #d92d20; }
  :global([data-theme='dark']) .ctl-feedback[data-state='ok'] { color: #75e0a7; }
  :global([data-theme='dark']) .ctl-feedback[data-state='refused'] { color: #fda29b; }

  /* ---- Tableau de bord : compact, dans le verre de la page ---- */
  .station--compact {
    gap: 10px; padding: 14px 18px; border-radius: 18px; color: var(--raisin);
    border: 1px solid var(--glass-border); background: var(--glass);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.4); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
    box-shadow: 0 4px 16px rgba(30, 41, 82, 0.08);
  }
  .station--compact .station-head { gap: 4px 10px; font-size: 13px; }
  /* Avec les commandes : sur grand écran, elles prennent place sur la ligne de l'état, pour ne pas
     voler de hauteur au tableau de bord, qui ne défile pas ; le retour de commande s'affiche dessous */
  .station--compact:has(.station-controls) {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'head controls' 'cards cards';
